datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ENTRY_FEE
  GAME_WIN
  REFERRAL_BONUS
  DAILY_BONUS
  WELCOME_BONUS
  ADMIN_ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum RoomType {
  FREE
  PAID
  TOURNAMENT
}

enum GameType {
  BINGO
  KENO
}

enum GameState {
  WAITING
  PLAYING
  FINISHED
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  username          String              @unique
  passwordHash      String
  role              Role                @default(USER)
  isVerified        Boolean             @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExp     DateTime?
  referralCode      String              @unique
  referredById      String?
  referredBy        User?               @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]              @relation("Referrals")
  isBanned          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  wallet            Wallet?
  transactions      Transaction[]
  bingoCards        BingoCard[]
  gameParticipants  GameParticipant[]
  kenoTickets       KenoTicket[]
  kenoWagers        KenoWager[]
  withdrawRequests  WithdrawalRequest[]
  depositRequests   DepositRequest[]
  referredEarnings  ReferralEarning[]
  dailyBonuses      DailyBonusLog[]
  notifications     Notification[]
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance          Decimal  @default(0.0)
  totalWinnings    Decimal  @default(0.0)
  referralEarnings Decimal  @default(0.0)
  updatedAt        DateTime @updatedAt
}

model Transaction {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                TransactionType
  amount              Decimal
  status              TransactionStatus  @default(COMPLETED)
  description         String?
  withdrawalRequestId String?            @unique
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
}

model BingoRoom {
  id            String      @id @default(uuid())
  name          String
  type          RoomType    @default(FREE)
  game          GameType    @default(BINGO)
  entryFee      Decimal     @default(0.0)
  prizePool     Decimal     @default(0.0)
  maxPlayers    Int         @default(50)
  createdAt     DateTime    @default(now())
  games         BingoGame[]
  kenoGames     KenoGame[]
}

model BingoGame {
  id           String            @id @default(uuid())
  roomId       String
  room         BingoRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  state        GameState         @default(WAITING)
  numbersCalled Int[]
  winningCardId String?
  winnerId      String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())
  
  participants GameParticipant[]
  cards        BingoCard[]
}

model GameParticipant {
  id        String    @id @default(uuid())
  gameId    String
  game      BingoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBot     Boolean   @default(false)
  joinedAt  DateTime  @default(now())
}

model BingoCard {
  id        String    @id @default(uuid())
  gameId    String
  game      BingoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grid      Json      // 5x5 array of integers/null (null for FREE space)
  daubed    Json      // 5x5 boolean array representing daubed cells
  isWinner  Boolean   @default(false)
  isBot     Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model KenoGame {
  id           String       @id @default(uuid())
  roomId       String
  room         BingoRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  state        GameState    @default(WAITING)
  drawnNumbers Int[]
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())

  tickets      KenoTicket[]
}

model KenoTicket {
  id        String   @id @default(uuid())
  gameId    String
  game      KenoGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spots     Int[]
  matched   Int      @default(0)
  payout    Decimal  @default(0.0)
  isWinner  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model KenoWager {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bet        Decimal
  picks      Int[]
  drawn      Int[]
  matches    Int      @default(0)
  multiplier Int      @default(0)
  payout     Decimal  @default(0.0)
  isWin      Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ReferralEarning {
  id          String   @id @default(uuid())
  userId      String   // Referrer
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredId  String   // Friend
  amount      Decimal
  createdAt   DateTime @default(now())
}

model DailyBonusLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  streakDay Int      @default(1)
  amount    Decimal
  claimedAt DateTime @default(now())
}

model WithdrawalRequest {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  address     String            // Wallet / Crypto address
  status      TransactionStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())

  transaction Transaction?
}

model DepositRequest {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  txHash      String            // Mock blockchain / payment tx hash
  status      TransactionStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
}

model AdminSetting {
  key   String @id
  value String
}

model AdminActivityLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
